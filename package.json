{
  "name": "groundtruth",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm -r typecheck && pnpm -r lint && pnpm -r test",
    "format": "prettier --write .",
    "dev:web": "pnpm --filter @groundtruth/web dev",
    "eval:verification": "pnpm --filter @groundtruth/web eval:verification",
    "demo:reset": "pnpm --filter @groundtruth/web demo:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
