XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_REASONING_MODEL=grok-4.7
GROK_FAST_VISION_MODEL=grok-4.20-non-reasoning
GROK_IMAGE_MODEL=grok-imagine-image-2.0
GROK_VIDEO_MODEL=grok-imagine-video-1.5
GROK_VOICE_MODEL=grok-voice-latest
# grok-4.7 reasoning effort for verification: low | medium (default) | high | xhigh
# (low was measured 2026-09-26 and accepted Imagine fakes that medium caught — don't use it)
GROK_VERIFICATION_EFFORT=medium
# Optional verification knobs (defaults shown): frame long edge px, image detail high|mixed|low, call budget
# VERIFICATION_FRAME_MAX_EDGE=1536
# VERIFICATION_IMAGE_DETAIL=high
# GROK_VERIFICATION_TIMEOUT_MS=150000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NWS_USER_AGENT="GroundTruth hackathon (you@example.com)"
# 1 = deterministic Grok fixtures (they approve anything). Refused unless LOCAL_BACKEND=1, because a mock
# "accept" once reached the public dataset from the hosted DB. Rows decided in mock mode get
# verifier=mock and are never exported or published.
MOCK_GROK=0
# 1 = allow MOCK_GROK=1 against a non-local DATABASE_URL anyway (scratch-project e2e only). Keep 0.
ALLOW_MOCK_ON_REAL_DB=0
DEMO_MODE=1

# Postgres connection string of the Supabase project (Project Settings → Database → Connection string).
# The API reads/writes the DB with it directly (service-level: bypasses RLS; routes do their own auth).
# The transaction pooler (port 6543) works: prepared statements are disabled.
DATABASE_URL=

# 1 = no Supabase needed: in-process Postgres (PGlite, persisted in apps/web/.local/pglite) with the real
# migrations + seed, filesystem storage (apps/web/.local/storage) behind signed /api/dev/* URLs, and dev
# bearer tokens from POST /api/dev/session. No realtime (clients poll GET /api/submissions/:id).
# Never enable on a shared deployment: dev tokens are unauthenticated.
LOCAL_BACKEND=0

# Comma-separated NWS alert events that pause captures in intersecting cells (severity "Extreme" always does).
HAZARD_PAUSE_EVENTS="Flash Flood Emergency,Tornado Warning,Tornado Emergency,Extreme Wind Warning"

# 1 = skip outbound Open-Meteo / NWS calls (offline dev); those subchecks show as skipped.
OFFLINE_CONTEXT=0

# Accounts / data rights (migration 000006)
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/retention (daily, vercel.json).
# 16+ random characters; the route refuses every call while this is unset.
CRON_SECRET=
# Photos of rejected submissions are deleted this many days after the decision.
REJECTED_MEDIA_RETENTION_DAYS=30
# e2e:mock against Supabase signs in as the seeded admin; its password is never in the repo.
E2E_RESEARCHER_PASSWORD=
# Public origin of the dashboard, no trailing slash (e.g. https://groundtruth-two-snowy.vercel.app).
# Forgot-password emails link to $NEXT_PUBLIC_SITE_URL/reset-password (Supabase `redirect_to`); add that
# URL to Supabase Auth → URL Configuration → Redirect URLs. Never derived from the request Host header.
# Unset → Supabase uses the project's Site URL. LOCAL_BACKEND prints the code to the dev console instead.
NEXT_PUBLIC_SITE_URL=
# LOCAL_BACKEND only: 1 = skip rate limits (long local e2e loops). Ignored on a real backend.
RATE_LIMITS_DISABLED=0
