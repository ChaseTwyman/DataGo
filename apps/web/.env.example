XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_REASONING_MODEL=grok-4.7
GROK_FAST_VISION_MODEL=grok-4.20-non-reasoning
GROK_IMAGE_MODEL=grok-imagine-image-2.0
GROK_VIDEO_MODEL=grok-imagine-video-1.5
GROK_VOICE_MODEL=grok-voice-latest
# grok-4.7 reasoning effort for verification: low | medium (default) | high | xhigh
GROK_VERIFICATION_EFFORT=medium
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NWS_USER_AGENT="GroundTruth hackathon (you@example.com)"
MOCK_GROK=0
DEMO_MODE=1

# Postgres connection string of the Supabase project (Project Settings → Database → Connection string).
# The API reads/writes the DB with it directly (service-level: bypasses RLS; routes do their own auth).
# The transaction pooler (port 6543) works: prepared statements are disabled.
DATABASE_URL=

# 1 = no Supabase needed: in-process Postgres (PGlite, persisted in apps/web/.local/pglite) with the real
# migrations + seed, filesystem storage (apps/web/.local/storage) behind signed /api/dev/* URLs, and dev
# bearer tokens from POST /api/dev/session. No realtime (clients poll GET /api/submissions/:id).
# Never enable on a shared deployment: dev tokens are unauthenticated.
LOCAL_BACKEND=0

# Comma-separated NWS alert events that pause captures in intersecting cells (severity "Extreme" always does).
HAZARD_PAUSE_EVENTS="Flash Flood Emergency,Tornado Warning,Tornado Emergency,Extreme Wind Warning"

# 1 = skip outbound Open-Meteo / NWS calls (offline dev); those subchecks show as skipped.
OFFLINE_CONTEXT=0
